{
  "name": "yallaplay",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:seed": "node scripts/seed.js",
    "db:seed:reset": "node scripts/seed.js --reset",
    "db:seed:indexes": "node scripts/seed.js --indexes"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "prettier": "^3.3.2",
    "eslint": "^9.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.1"
}
